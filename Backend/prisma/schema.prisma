// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
// @ts-ignore
datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}
// 1. USERS MODEL
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @db.VarChar(20) // 'Staff', 'Admin'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrders       PurchaseOrder[]
  inventoryTransactions InventoryTransaction[]

  @@map("users")
}

// 2. SUPPLIERS MODEL
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  code      String   @unique @db.VarChar(30)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  address   String?  @db.Text
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// 3. PRODUCT SIZES MODEL
model ProductSize {
  id       Int       @id @default(autoincrement())
  sizeName String    @map("size_name") @db.VarChar(50)

  // Relations
  products Product[]

  @@map("product_sizes")
}

// 4. PRODUCTS MODEL
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(30)
  description String?  @db.Text
  price       Decimal  @default(0.00) @db.Decimal(15, 2)
  sizeId      Int?     @map("size_id")
  imageUrl    String?  @map("image_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  size                 ProductSize?         @relation(fields: [sizeId], references: [id])
  inventory            Inventory?
  purchaseOrderDetails PurchaseOrderDetail[]
  inventoryTransactions InventoryTransaction[]

  @@map("products")
}

// 5. INVENTORY MODEL (Quan hệ 1:1 với Product)
model Inventory {
  productId         Int      @id @map("product_id")
  quantity          Int      @default(0)
  committedQuantity Int      @default(0) @map("committed_quantity")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// 6. PURCHASE ORDERS MODEL
model PurchaseOrder {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(30)
  supplierId  Int      @map("supplier_id")
  createdBy   Int      @map("created_by")
  issueDate   DateTime @default(now()) @db.Timestamp(0) @map("issue_date")
  note        String?  @db.Text
  totalAmount Decimal  @default(0.00) @db.Decimal(15, 2) @map("total_amount")
  status      String   @default("Draft") @db.VarChar(20) // 'Draft', 'Confirmed', 'Imported'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  user                 User                  @relation(fields: [createdBy], references: [id])
  purchaseOrderDetails PurchaseOrderDetail[]
  inventoryTransactions InventoryTransaction[]

  @@map("purchase_orders")
}

// 7. PURCHASE ORDER DETAILS MODEL
model PurchaseOrderDetail {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(15, 2) @map("unit_price")
  subtotal  Decimal @db.Decimal(15, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([orderId, productId], name: "unique_order_product")
  @@map("purchase_order_details")
}

// 8. INVENTORY TRANSACTIONS MODEL (Lịch sử kho)
model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  orderId         Int?     @map("order_id")
  userId          Int      @map("user_id")
  transactionType String   @map("transaction_type") @db.VarChar(20) // 'IN', 'OUT', 'ADJUST'
  quantityChanged Int      @map("quantity_changed")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  product       Product        @relation(fields: [productId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [orderId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  @@map("inventory_transactions")
}
